# Keep git's own files off the web when the site is served from a git clone.
RedirectMatch 404 /\.git
RedirectMatch 404 /\.github

# Compress SVG logos and other text files when the server supports it.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE image/svg+xml text/html text/css application/javascript application/json
</IfModule>
